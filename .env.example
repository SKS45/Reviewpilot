# --- Server ---
PORT=3000
REDIS_URL=redis://localhost:6379

# --- GitHub App (Settings > Developer settings > GitHub Apps) ---
GITHUB_APP_ID=
# Paste the PEM with literal \n for newlines, or the raw multi-line key
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- LLM: gemini | groq | ollama (free tiers / local) ---
# Model names change often; check each provider's docs for current ones.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Review limits ---
MAX_FILES_PER_PR=30
MAX_PATCH_CHARS=24000
MAX_COMMENTS_PER_PR=15
MIN_CONFIDENCE=0.6
# Keep at 1 on free LLM tiers to stay under rate limits
WORKER_CONCURRENCY=1
